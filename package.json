{
  "name": "quorumind",
  "private": true,
  "version": "0.1.0",
  "description": "Several AIs debate your project before you build it.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @quorumind/server & npm run dev -w @quorumind/web",
    "build": "npm run build -w @quorumind/web",
    "start": "npm run start -w @quorumind/server",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test -c apps/web/e2e/playwright.config.ts",
    "typecheck": "tsc -p packages/core && tsc -p apps/server && tsc -p apps/mcp && tsc -p apps/web && tsc -p apps/web/e2e && tsc -p bench && tsc -p media",
    "lint": "biome check .",
    "format": "biome check --write .",
    "bench": "node --disable-warning=ExperimentalWarning bench/run.ts",
    "prices:check": "node --disable-warning=ExperimentalWarning bench/prices.ts",
    "media": "npm run build && node --disable-warning=ExperimentalWarning media/capture.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "happy-dom": "21.0.4",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
