# Copy to .env and fill in at least one provider. Without any key, only the demo is available.

# Anthropic (Claude). Default model for every role when set.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Models offered in the picker (comma-separated).
# ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# ANTHROPIC_EFFORT=high

# OpenAI. The key and at least one model are required; with two vendors set,
# proposer B uses the second one so two different vendors debate.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_MODELS=
# Price per million tokens in USD, applied to every listed OpenAI model, to track
# costs and enforce the cost cap.
# OPENAI_PRICE_INPUT=
# OPENAI_PRICE_OUTPUT=
# OPENAI_BASE_URL=
# Send the debate depth as reasoning effort. Only for models that accept it.
# OPENAI_REASONING=1

# Google Gemini. The key and at least one model are required.
GEMINI_API_KEY=
GEMINI_MODEL=
# GEMINI_MODELS=
# GEMINI_PRICE_INPUT=
# GEMINI_PRICE_OUTPUT=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Ollama (local models, free). Set either variable to enable it; without
# OLLAMA_MODELS, the models Ollama has pulled are listed.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODELS=
# 100 % local: only Ollama models, no data leaves the machine.
# QUORUMIND_LOCAL_ONLY=1

# Optional: assign roles explicitly, as provider:model (anthropic, openai, gemini,
# ollama) or mock. Seats C and D and the devil's advocate are off unless set.
# QUORUMIND_INTERVIEWER=anthropic:claude-opus-5-5
# QUORUMIND_ARBITER=anthropic:claude-opus-5-5
# QUORUMIND_SEAT_A=anthropic:claude-opus-5-5
# QUORUMIND_SEAT_B=openai:your-model
# QUORUMIND_SEAT_C=gemini:your-model
# QUORUMIND_SEAT_D=ollama:your-model
# QUORUMIND_DEVIL=none

# Server
PORT=8787
# HOST=127.0.0.1
# QUORUMIND_DATA_DIR=./data
