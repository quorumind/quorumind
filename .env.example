# Copy to .env and fill in at least one provider. Without any key, only the demo is available.

# Anthropic (Claude). Default model for every role when set.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high

# OpenAI. Both the key and the model are required; with both providers set,
# proposer B uses OpenAI so two different vendors debate.
OPENAI_API_KEY=
OPENAI_MODEL=
# Price per million tokens in USD, to track costs and enforce the cost cap.
# OPENAI_PRICE_INPUT=
# OPENAI_PRICE_OUTPUT=
# OPENAI_BASE_URL=

# Optional: assign roles explicitly, as provider:model (anthropic, openai) or mock.
# QUORUMIND_INTERVIEWER=anthropic:claude-opus-5-5
# QUORUMIND_ARBITER=anthropic:claude-opus-5-5
# QUORUMIND_SEAT_A=anthropic:claude-opus-5-5
# QUORUMIND_SEAT_B=openai:your-model

# Server
PORT=8787
# HOST=127.0.0.1
# QUORUMIND_DATA_DIR=./data
