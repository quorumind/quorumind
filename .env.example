# Copy to .env and fill in at least one provider. Without any key, only the demo is available.

# Anthropic (Claude). Default model for every role when set.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Models offered in the picker (comma-separated).
# ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# ANTHROPIC_EFFORT=high

# OpenAI. The key and at least one model are required; with two vendors set,
# proposer B uses the second one so two different vendors debate.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_MODELS=
# Price per million tokens in USD, applied to every listed OpenAI model, to track
# costs and enforce the cost cap.
# OPENAI_PRICE_INPUT=
# OPENAI_PRICE_OUTPUT=
# OPENAI_BASE_URL=
# Send the debate depth as reasoning effort. Only for models that accept it.
# OPENAI_REASONING=1

# Google Gemini. The key and at least one model are required.
GEMINI_API_KEY=
GEMINI_MODEL=
# GEMINI_MODELS=
# GEMINI_PRICE_INPUT=
# GEMINI_PRICE_OUTPUT=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# OpenRouter: one key for the models of every maker (Claude, GPT, Gemini, Mistral...).
# Prices come from OpenRouter's model list and each call's exact cost from OpenRouter;
# only endpoints that keep no data are used.
OPENROUTER_API_KEY=
# Models offered (comma-separated OpenRouter ids). Defaults to the flagship and mid-tier
# models of Anthropic, OpenAI, Google and Mistral.
# OPENROUTER_MODELS=anthropic/claude-opus-5.5,mistralai/mistral-large-4-0
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama (local models, free). Set either variable to enable it; without
# OLLAMA_MODELS, the models Ollama has pulled are listed.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODELS=
# 100 % local: only Ollama models, no data leaves the machine.
# QUORUMIND_LOCAL_ONLY=1

# Optional: assign roles explicitly, as provider:model (anthropic, openai, gemini,
# openrouter, ollama) or mock. Seats C and D and the devil's advocate are off unless set.
# QUORUMIND_INTERVIEWER=anthropic:claude-opus-5-5
# QUORUMIND_ARBITER=anthropic:claude-opus-5-5
# QUORUMIND_SEAT_A=anthropic:claude-opus-5-5
# QUORUMIND_SEAT_B=openai:your-model
# QUORUMIND_SEAT_C=gemini:your-model
# QUORUMIND_SEAT_D=ollama:your-model
# QUORUMIND_DEVIL=none

# Server
PORT=8787
# For npm start only: docker compose sets both itself (HOST=0.0.0.0 inside the container, the data on its volume)
# HOST=127.0.0.1
# QUORUMIND_DATA_DIR=./data
# Without sign-in, the server answers for localhost, 127.0.0.1, [::1] and the host of
# QUORUMIND_PUBLIC_URL only, and refuses requests from other sites (DNS rebinding and
# cross-site requests). Other names it is reached by, comma-separated (host or host:port);
# * answers for any name, and still refuses other sites.
# QUORUMIND_ALLOWED_HOSTS=quorumind.lan,192.168.1.20
# Behind reverse proxies, how many of them add the client address to X-Forwarded-For
# (1 for a single nginx or Caddy). The per-visitor limits (share and questionnaire
# passwords, questionnaire links, imports) then count each visitor on its own instead
# of the proxy. Leave it unset when the server is reached directly: the header could
# be forged.
# QUORUMIND_TRUST_PROXY=1

# Sessions are kept in a SQLite file in QUORUMIND_DATA_DIR. To keep them in PostgreSQL
# instead, give its address; the tables are created at start-up. DATABASE_URL_FILE can
# point to a file holding it (a Docker secret, for instance).
# DATABASE_URL=postgres://quorumind:password@127.0.0.1:5432/quorumind

# Data: delete sessions nobody touched for this many days (unset keeps them forever).
# QUORUMIND_RETENTION_DAYS=180

# E-mail when a long debate ends or waits for your answer (optional).
# QUORUMIND_SMTP_URL=smtps://user:password@smtp.example.com:465
# QUORUMIND_MAIL_FROM=Quorumind <quorumind@example.com>
# QUORUMIND_NOTIFY_EMAIL=you@example.com
# QUORUMIND_PUBLIC_URL=http://127.0.0.1:8787

# Slack or Microsoft Teams message when any session waits for answers, finishes or
# fails (optional). A Slack incoming webhook (https://hooks.slack.com/services/...), a
# Teams webhook (*.webhook.office.com) or Teams workflow (*.logic.azure.com). Keep them
# secret: anyone with the address can post in the channel. *_FILE variants read the
# address from a file (a Docker secret, for instance). Off with QUORUMIND_LOCAL_ONLY.
# QUORUMIND_SLACK_WEBHOOK_URL=
# QUORUMIND_TEAMS_WEBHOOK_URL=

# Context documents (specifications, web pages, GitHub repositories)
# A GitHub token raises the API limit from 60 to 5 000 requests an hour and gives
# access to private repositories. A fine-grained token with read-only "Contents"
# and "Metadata" permissions is enough.
# GITHUB_TOKEN=
# Web pages on private networks (intranet, localhost, 10.x, 192.168.x, cloud
# metadata…) are refused so that a pasted address cannot make the server probe its
# own network. Set to 1 only on a self-hosted instance whose users you trust.
# QUORUMIND_ALLOW_PRIVATE_URLS=1
